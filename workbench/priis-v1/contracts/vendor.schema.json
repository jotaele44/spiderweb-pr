{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://priis.local/schemas/vendor.schema.json",
  "title": "Vendor",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "$ref": "common.defs.schema.json#/$defs/id" },
    "name": { "type": "string", "minLength": 2 },
    "risk": { "$ref": "common.defs.schema.json#/$defs/score" },
    "tier": { "$ref": "common.defs.schema.json#/$defs/tier" },
    "industry": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "source_ids": { "type": "array", "items": { "$ref": "common.defs.schema.json#/$defs/sourceRef" } }
  },
  "additionalProperties": false
}
