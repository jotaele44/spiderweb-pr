# ── OS / build cruft ──────────────────────────────────────────────────────────
.DS_Store
__pycache__/
*.pyc

# ── Node / npm dependencies (never commit — reproduced from package-lock) ─────
# General guard for any nested node_modules anywhere in the tree, plus the
# specific frontend path that was previously committed in error (~3.6k files).
**/node_modules/
node_modules/
server/frontend/node_modules/

# ── Runtime artifact directories (never commit contents) ─────────────────────
# outputs/ — all generated files (parquet, GeoJSON, JSON, JSONL, CSV, DB)
outputs/*
!outputs/.gitkeep
# outputs.zip — packaged outputs snapshot at repo root (build artifact)
outputs.zip

# Road name gazetteer ingest — generated artifacts (245 MB across 85 files under
# data/reference/). Regenerable: pipeline/download_road_sources.py re-fetches the
# upstream sources, then pipeline/road_gazetteer_ingest.py rebuilds the processed
# CSVs. The pipeline, schemas, tests and runbook above it are tracked.
spiderweb_pr_road_name_gazetteer_ingest/data/

# data/ — input datasets (screenshots, GEBCO .nc, social CSV, etc.)
data/*
!data/.gitkeep
# PR-intake dropzone (#41): the router delivers spiderweb_pr_derivatives.csv here
!data/intake/
!data/intake/pr_intake/
!data/intake/pr_intake/.gitkeep
!data/intake/pr_intake/README.md
!data/intake/pr_intake/spiderweb_pr_derivatives.csv
# RLSM: track the schema contract and operator handoff doc, keep large DBs ignored
!data/rlsm/
data/rlsm/*
!data/rlsm/schema.sql
!data/rlsm/HANDOFF.md
# NamUs missing-persons: allowlist the provenance README; raw + canonical CSVs
# stay ignored (PII at the source; redacted-but-still-personal at the canonical).
# The `data/sources/namus/*` re-ignore re-blocks dated snapshot subdirs so
# `data/sources/namus/2026-06-11/namus_mp_pr.csv` is never tracked even though
# the parent `data/sources/namus/` is allowlisted for the README.
!data/sources/
# Re-block loose source datasets dropped directly under data/sources/ (the
# .gpkg/.geojson/.csv/.sqlite inputs); like all of data/ these are operator-local
# inputs per DATA_POLICY.md and must never be committed. Allowlist provenance
# (READMEs) explicitly below, mirroring the namus pattern.
data/sources/*
!data/sources/namus/
data/sources/namus/*
!data/sources/namus/README.md

# Census Partnership source adapter: raw downloads and extracted shapefile trees
# are runtime-only. Directory-level ignores scope shapefile sidecars to Census paths.
data/raw/census_partnership_pr/
data/extracted/census_partnership_pr/
cache/census_partnership_pr/

# TIGER/Line ingest (server/ingestion/ingest_tiger_pr.py): raw zips and the
# regenerable <layer>.geojson outputs stay runtime-only; track only the small
# provenance manifest. Re-include nested dirs before allowlisting the file since
# `data/*` above ignores the whole data/ tree.
!data/tiger/
data/tiger/*
!data/tiger/2025/
data/tiger/2025/*
!data/tiger/2025/manifest.json

# Reference-geo ingest (server/ingestion/ingest_reference_geo.py): raw source
# caches and the regenerable <layer>.geojson outputs stay runtime-only; track
# only the small per-layer provenance manifests.
!data/reference_geo/
data/reference_geo/*
!data/reference_geo/*_manifest.json

# input/ — operator-local override for recover-tails FAA N-number list +
# timestamped auto-backups + derived skip-list. The hermetic CI fallback
# lives at tests/fixtures/regs.txt (already tracked), so the pipeline runs
# without input/ being present. Operator's local input stays local.
input/

# registration_recovery_queue.csv — when produced canonically by
# server/ingestion/reconcile_registrations.py, it writes to
# outputs/registration_recovery_queue.csv (already covered by outputs/*).
# A repo-root copy is a misplaced manual snapshot — also ignore so it
# doesn't get accidentally committed.
/registration_recovery_queue.csv

# cache/ — intermediate results, model caches
cache/*
!cache/.gitkeep

# tile_cache/ — EarthGPT XYZ tile PNGs
tile_cache/*
!tile_cache/.gitkeep

# ── Credentials and environment ───────────────────────────────────────────────
.env
.envrc
*.env
HF_TOKEN

# ── SQLite databases ──────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Spiderweb operational output files ───────────────────────────────────────
# Written by --export-spiderweb, --spiderweb-intake, --calibrate-scoring.
# Should be written to dedicated export dirs; guard against root-dir commits.
spiderweb_overlay_candidates.geojson
spiderweb_gap_audit.json
calibration_report.json
spiderweb_ingest_manifest.json
prii_readiness_report.json

# ── Common generated data formats ─────────────────────────────────────────────
*.parquet
*.jsonl
# Committed fixtures/samples are not generated data — keep them tracked so a bare
# `git add` can't silently drop them (see the moneysweep_v1_2 CI incident).
!tests/fixtures/**/*.jsonl
!exports/**/*.jsonl
# Federation evidence ledgers are audit artifacts, not generated data.
!reports/federation/*.jsonl
*.nc          # NetCDF (GEBCO)

# ── ChromaDB vector index ─────────────────────────────────────────────────────
pruap_index/

# ── Byte-compiled / optimized / DLL files ────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec
!desktop/pyinstaller.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

