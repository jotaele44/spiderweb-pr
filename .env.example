# Example environment configuration (T11-88).
# Copy to `.env` and fill in real values. NEVER commit a real `.env`
# (it is gitignored). No production credentials live in this repository.

# Hugging Face token for the RAG / EarthGPT extras (optional).
HF_TOKEN=

# Reddit API credentials for the RAG ingest (optional; the `rag` extra).
PRAW_CLIENT_ID=
PRAW_CLIENT_SECRET=
PRAW_USER_AGENT=spiderweb-pr/0.1

# Operator-supplied municipal centroid CSV for MBIL (optional; T7-60).
# Columns: lat,lon
SPIDERWEB_CENTROID_CSV=

# Google Maps Geocoding API key (optional; scripts/geocode_pr.py GoogleBackend).
# PAID / cost-bearing — billed per request beyond Google's free tier. Leave blank
# to skip the Google backend; geocoding falls back to Census then Nominatim.
SPIDERWEB_GOOGLE_GEOCODER_KEY=

# ── Server alert notifications (optional; server/notifications/notifier.py) ───
# Both channels are disabled unless configured. Webhook fires if ALERT_WEBHOOK_URL
# is set; email fires only if ALERT_EMAIL_TO and ALERT_SMTP_HOST are both set.
ALERT_WEBHOOK_URL=
ALERT_SMTP_HOST=
# ALERT_SMTP_PORT defaults to 25 if unset.
ALERT_SMTP_PORT=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# ALERT_EMAIL_FROM defaults to alerts@priis.local if unset.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ── Imagery MCP server (the `imagery` extra) ─────────────────────────────────
# Satellite imagery providers. GIBS needs no credentials; the others use OAuth2
# client-credentials. Leave blank to disable a provider.
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Optional overrides (see imagery/config.py for the full list):
# IMAGERY_DEFAULT_PROVIDER=gibs
# IMAGERY_CACHE_DIR=tile_cache/imagery
# IMAGERY_BUFFER_DEG=0.05
# IMAGERY_IMAGE_SIZE=512
