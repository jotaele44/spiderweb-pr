{
  "schema_version": "repo_federation_manifest_v1",
  "program_id": "spiderweb-pr",
  "repository_full_name": "jotaele44/spiderweb-pr",
  "repository_legacy_name": "spiderweb-pr",
  "federation_role": "spatial_operational_query_hub",
  "hub_parent": "thehub-pr",
  "jurisdiction": "Puerto Rico",
  "active_vector": "SPIDERWEB_SPATIAL_OPERATIONAL_QUERY_HUB",
  "production_status": "NON_PRODUCTION_DIAGNOSTIC",
  "pause_lock_required": true,
  "source_truth": {
    "role_note": "Dual producer/consumer: produces a spatial/operational evidence-envelope export AND hosts the federation query-hub that ingests other producers' packages (e.g. contract-sweeper-export).",
    "producer_side": {
      "export_writer": "federation/export_writer.py",
      "export_envelope": "federation/envelope.py",
      "validator": "scripts/validate_export.py",
      "sample_package": "exports/samples/manifest.sample.json",
      "streams": [
        "events",
        "observations",
        "tracks",
        "sources"
      ]
    },
    "consumer_side": {
      "query_hub": "federation/hub/query.py",
      "contract_sweeper_adapter": "federation/hub/adapters/contract_sweeper.py",
      "spatial_lane": "federation/hub/layer_registry.py",
      "ingest_script": "scripts/ingest_contract_sweeper_package.py"
    }
  },
  "hub_callable_commands": {
    "setup": "python -m pip install jsonschema pyarrow pytest shapely numpy",
    "test_suite": "python -m pytest tests/ -q --tb=short --ignore=tests/test_io.py --ignore=tests/test_terrain.py",
    "validate_schemas": "make validate-schemas",
    "validate_export": "python scripts/validate_export.py --package exports/samples --mode test",
    "build_spatial_lane": "python scripts/build_spiderweb_spatial_lane.py",
    "export_canonical": "python3 scripts/federation_export.py --mode test"
  },
  "canonical_outputs": {
    "export_sample_manifest": "exports/samples/manifest.sample.json",
    "spatial_intake_items": "data/normalized/spatial_intake_items.csv",
    "federation_readiness_doc": "docs/federation_readiness.md",
    "canonical_export_dir": "exports/federation"
  },
  "federation_readiness_gate": {
    "ready_for_hub_discovery": true,
    "ready_for_hub_live_execution": false,
    "blocking_conditions": [
      "canonical export adapter (scripts/federation_export.py) projects the envelope streams (events/observations/tracks/sources) -> entities/sources/relationships; geometry is not yet carried on canonical entities (Z2 follow-up), so the query-hub's correlate_spatial has no entity geometry to join on",
      "live production export requires real (non-synthetic) rows; the mode=test->production gate in docs/federation_readiness.md must pass"
    ]
  }
}
