{
  "name": "spiderweb-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:gui-parity": "playwright test -c gui-parity.playwright.config.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
