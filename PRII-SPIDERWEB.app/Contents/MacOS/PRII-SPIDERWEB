#!/bin/bash
# macOS .app launcher for the PRII desktop wrapper. Self-locating: resolves the
# repo root from this bundle's own path. Once setup is complete it opens the
# app directly; until then it hands over to a Terminal window that runs the
# one-time setup and reopens this app when it is done.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/../../.." && pwd)"

notify() { osascript -e "display dialog \"$1\" buttons {\"OK\"} with title \"Spiderweb — PRII\"" >/dev/null 2>&1 || true; }

# Gatekeeper "App Translocation": when a quarantined .app is opened from where
# it was unzipped, macOS runs it from a read-only disk image under a random
# /private/var/folders/…/AppTranslocation/ path. Only the bundle is copied
# there, so the checkout next to it is gone and setup cannot write a .venv.
# Note that "Open Anyway" permits one launch without clearing the quarantine
# flag, so it leaves the bundle translocated and lands people here.
case "$HERE" in
  */AppTranslocation/*)
    notify "macOS is running this app from a temporary read-only copy, so it cannot see the rest of the checkout.\n\nFix it once:\n1. Move the folder that contains this app out of Downloads (or the Trash) — your home folder is fine.\n2. Double-click Fix-Gatekeeper.command in that folder.\n3. Open this app again."
    exit 1
    ;;
esac

if [ ! -f "$REPO/desktop/setup.py" ]; then
  notify "This app must stay inside its checkout — desktop/setup.py was not found next to it.\n\nLooked in: $REPO\n\nMove PRII-SPIDERWEB.app back beside the checkout's desktop folder and open it from there."
  exit 1
fi

cd "$REPO"

# Same three things desktop/setup.py's is_complete() checks. Testing them here
# means a set-up checkout starts without needing a system Python at all.
if [ -f desktop/.setup-complete ] && [ -x .venv/bin/python ] \
  && [ -f server/frontend/dist/index.html ]; then
  exec .venv/bin/python desktop/launch.py
fi

# Not set up yet (or setup was left half-done). Finder discards this launcher's
# output and gives it a minimal PATH, so run setup where the person can watch
# it: a Terminal window, which also loads their normal shell environment.
# `open -a Terminal <file>` needs no Automation permission.
SETUP="$HERE/../Resources/first-run-setup.command"
chmod +x "$SETUP" 2>/dev/null || true
if ! open -a Terminal "$SETUP"; then
  notify "Could not open a Terminal window to finish first-run setup.\n\nDouble-click PRII-SPIDERWEB.command in $REPO instead."
  exit 1
fi
