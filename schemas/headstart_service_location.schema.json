{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "headstart_service_location",
  "title": "Head Start Service Location (RESTRICTED — precise points)",
  "description": "RESTRICTED precise service-location point for the civic Head Start PR layer, emitted by spiderweb/ingestors/ingest_headstart.py::service_feature. sensitivity=high, public_export=grid_only — this artifact must NOT be published under exports/samples; public release uses headstart_context_grid only. One GeoJSON Feature per service location.",
  "type": "object",
  "required": ["type", "geometry", "properties"],
  "properties": {
    "type": {"const": "Feature"},
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Point"},
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {"type": "number", "minimum": -67.4, "maximum": -65.1},
            {"type": "number", "minimum": 17.7, "maximum": 18.6}
          ]
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "required": ["id", "source_id", "layer_id", "node_type", "label", "operator_id", "standalone_confidence", "sensitivity", "public_export"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "layer_id": {"const": "civic_headstart_pr"},
        "node_type": {"const": "headstart_service_location"},
        "label": {"type": "string"},
        "operator_id": {"type": "string", "minLength": 1},
        "recipient_name": {"type": "string"},
        "status": {"type": "string"},
        "funded_slots": {"type": "integer", "minimum": 0},
        "program_type_label": {"type": "string"},
        "standalone_confidence": {"type": "number", "minimum": 0, "maximum": 20},
        "sensitivity": {"const": "high"},
        "public_export": {"const": "grid_only"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
