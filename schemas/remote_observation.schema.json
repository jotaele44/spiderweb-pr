{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "remote_observation",
  "title": "Remote Observation",
  "description": "One dated remote-sensing detection tied to an AOI and one or more source scenes. candidate_status starts at 'candidate' and only an adjudication_event may reach 'confirmed'. evidence_tier records what the raised signals can establish — never more than that.",
  "type": "object",
  "required": [
    "observation_uid",
    "aoi_uid",
    "scene_uids",
    "detector_name",
    "detector_version",
    "evidence_tier",
    "geometry",
    "candidate_status"
  ],
  "properties": {
    "observation_uid":   {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "aoi_uid":           {"type": "string", "minLength": 1},
    "scene_uids":        {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "baseline_scene_uid":{"type": ["string", "null"]},
    "detector_name":     {"type": "string", "minLength": 1},
    "detector_version":  {"type": "string", "minLength": 1},
    "signals": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sar_amplitude_change",
          "coherence_loss",
          "optical_change",
          "terrain_morphology",
          "multi_epoch_lidar_elevation",
          "field_or_authoritative_record"
        ]
      }
    },
    "evidence_tier": {
      "type": "string",
      "enum": [
        "radar_change_candidate",
        "surface_decorrelation_candidate",
        "corroborated_surface_change_candidate",
        "high_confidence_disturbance",
        "measured_elevation_or_volume_change",
        "confirmed_classified_event"
      ]
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"type": "string", "enum": ["Point", "LineString", "Polygon"]},
        "coordinates": {}
      }
    },
    "change_start":      {"type": ["string", "null"]},
    "change_end":        {"type": ["string", "null"]},
    "measurement_value": {"type": ["number", "null"]},
    "measurement_unit":  {"type": ["string", "null"]},
    "confidence":        {"type": "number", "minimum": 0, "maximum": 100},
    "candidate_status":  {"type": "string", "enum": ["candidate", "supported_candidate", "confirmed", "rejected"]},
    "reason_codes":      {"type": "array", "items": {"type": "string"}},
    "review_status":     {"type": "string"}
  },
  "additionalProperties": true
}
