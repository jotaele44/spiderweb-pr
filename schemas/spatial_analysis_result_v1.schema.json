{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/spiderweb-pr/schemas/spatial_analysis_result_v1.schema.json",
  "title": "Spiderweb spatial-analysis-result/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "producer_repo", "analysis_id", "query_id", "subject_type", "subject_id", "subject_manifestation_id", "geometry_role", "input_geometry_hash", "target_domain", "spatial_state", "identity_state", "source_manifestation_ids", "measurement_classes", "resolution_summary", "analysis_engine_version", "crs_operation", "horizontal_source_crs", "horizontal_computation_crs", "vertical_datum", "depth_sign_convention", "units", "confidence_state", "analysis_timestamp_utc", "result_hash"],
  "properties": {
    "contract_version": {"const": "spatial-analysis-result/1.0"},
    "producer_repo": {"const": "spiderweb-pr"},
    "analysis_id": {"type": "string", "minLength": 1}, "query_id": {"type": "string", "minLength": 1},
    "subject_type": {"type": "string", "minLength": 1}, "subject_id": {"type": "string", "minLength": 1}, "subject_manifestation_id": {"type": "string", "minLength": 1},
    "geometry_role": {"type": "string", "minLength": 1}, "input_geometry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_time_start": {"type": ["string", "null"]}, "input_time_end": {"type": ["string", "null"]},
    "target_domain": {"type": "string", "minLength": 1}, "target_feature_id": {"type": ["string", "null"]}, "target_candidate_id": {"type": ["string", "null"]},
    "spatial_state": {"enum": ["FULLY_WITHIN", "PARTIAL", "TOUCH_ONLY", "OUTSIDE", "NULL_EMPTY", "UNRESOLVED"]},
    "identity_state": {"enum": ["AUTHORITATIVE_BINDING", "CANDIDATE_NOT_IDENTITY", "UNRESOLVED"]},
    "source_manifestation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "measurement_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["DIRECT_MULTIBEAM", "DIRECT_SINGLE_BEAM", "SATELLITE_DERIVED", "INTERPOLATED", "MODELED", "CARTOGRAPHIC_RENDER"]}},
    "resolution_summary": {"type": "object", "additionalProperties": false, "required": ["best_m", "worst_m", "dominant_m", "direct_coverage_fraction", "interpolated_fraction", "nodata_fraction"], "properties": {"best_m": {"type": ["number", "null"], "exclusiveMinimum": 0}, "worst_m": {"type": ["number", "null"], "exclusiveMinimum": 0}, "dominant_m": {"type": ["number", "null"], "exclusiveMinimum": 0}, "direct_coverage_fraction": {"type": "number", "minimum": 0, "maximum": 1}, "interpolated_fraction": {"type": "number", "minimum": 0, "maximum": 1}, "nodata_fraction": {"type": "number", "minimum": 0, "maximum": 1}}},
    "distance_m": {"type": ["number", "null"], "minimum": 0}, "intersection_length_m": {"type": ["number", "null"], "minimum": 0}, "intersection_area_m2": {"type": ["number", "null"], "minimum": 0},
    "surface_depth_min_m": {"type": ["number", "null"]}, "surface_depth_max_m": {"type": ["number", "null"]}, "surface_depth_mean_m": {"type": ["number", "null"]}, "slope_max_deg": {"type": ["number", "null"]}, "local_relief_m": {"type": ["number", "null"], "minimum": 0},
    "analysis_engine_version": {"type": "string", "minLength": 1}, "crs_operation": {"type": "string", "minLength": 1}, "horizontal_source_crs": {"type": "string", "minLength": 1}, "horizontal_computation_crs": {"type": "string", "minLength": 1}, "vertical_datum": {"type": ["string", "null"]}, "depth_sign_convention": {"enum": ["positive_up", "positive_down"]}, "units": {"const": "metres"}, "confidence_state": {"type": "string", "minLength": 1}, "analysis_timestamp_utc": {"type": "string", "format": "date-time"}, "result_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
