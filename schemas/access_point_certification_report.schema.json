{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "access_point_certification_report",
  "title": "Access-point release certification report",
  "description": "Machine-readable release report for the access-point registries. Every gate carries a state and the class of the claim behind it. Engineering, science, GUI, federation and production readiness are reported separately. A passing test suite is not a certification, and this report cannot record an independent review that did not take place.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_utc",
    "repositories",
    "gates",
    "readiness",
    "scores",
    "artifacts",
    "independent_review",
    "production_authorized"
  ],
  "properties": {
    "schema": {
      "const": "access_point_certification_report/1.0"
    },
    "generated_utc": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "head_sha"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tree_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "title",
          "state",
          "claim_class",
          "evidence",
          "detail"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "PASS",
              "FAIL",
              "OPEN",
              "BLOCKED",
              "PROVISIONAL",
              "UNRESOLVED"
            ]
          },
          "claim_class": {
            "enum": [
              "FACT",
              "COMPUTED",
              "BINDING",
              "INFERENCE",
              "ASSUMPTION",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineering",
        "science",
        "gui",
        "federation",
        "production"
      ],
      "properties": {
        "engineering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "statement"
          ],
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "OPEN",
                "BLOCKED",
                "PROVISIONAL",
                "UNRESOLVED"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "science": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "statement"
          ],
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "OPEN",
                "BLOCKED",
                "PROVISIONAL",
                "UNRESOLVED"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "gui": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "statement"
          ],
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "OPEN",
                "BLOCKED",
                "PROVISIONAL",
                "UNRESOLVED"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "federation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "statement"
          ],
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "OPEN",
                "BLOCKED",
                "PROVISIONAL",
                "UNRESOLVED"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "statement"
          ],
          "properties": {
            "state": {
              "enum": [
                "PASS",
                "FAIL",
                "OPEN",
                "BLOCKED",
                "PROVISIONAL",
                "UNRESOLVED"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "verified",
          "projected",
          "basis"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "verified": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "projected": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "measurements": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "reviewer",
        "statement"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "production_authorized": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "independent_review": {
            "properties": {
              "performed": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "production_authorized": {
            "const": false
          },
          "readiness": {
            "properties": {
              "production": {
                "properties": {
                  "state": {
                    "enum": [
                      "OPEN",
                      "BLOCKED",
                      "FAIL",
                      "UNRESOLVED"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
