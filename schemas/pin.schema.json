{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pin",
  "title": "Master Pin Registry — Pin record",
  "description": "One atomic Pin in the Spiderweb-PR Master Pin Registry. A Pin is any mapped object, place, asset, event location, signal, anomaly, candidate, infrastructure node, or analytic marker that can be spatially referenced and assigned evidence metadata. Replaces the legacy POI / Entity / Feature / Location vocabulary (GeoJSON `Feature`/`FeatureCollection` wire constants are NOT renamed — they are the RFC 7946 serialization format, distinct from a Pin).",
  "type": "object",
  "required": ["pin_uid", "pin_name", "domain", "pin_group", "pin_class", "pin_layer", "geometry_type", "status"],
  "properties": {
    "pin_uid": {
      "type": "string",
      "pattern": "^PIN_[A-Z0-9]+(_[A-Z0-9]+)*_[0-9]{6}$",
      "description": "Permanent Spiderweb ID, e.g. PIN_EDU_PUBSCH_000001."
    },
    "pin_name": {"type": "string", "minLength": 1, "description": "Canonical name."},
    "pin_aliases": {"type": "array", "items": {"type": "string"}, "description": "Known alternate names."},
    "domain": {"type": "string", "minLength": 1, "description": "Highest thematic container."},
    "pin_group": {"type": "string", "minLength": 1, "description": "Major folder inside a domain."},
    "pin_class": {"type": "string", "minLength": 1, "description": "Specific category of mapped object."},
    "pin_subclass": {"type": "string", "description": "Optional refinement of pin_class."},
    "pin_layer": {"type": "string", "minLength": 1, "description": "Source GIS layer / table holding one geometry type or schema variant."},
    "geometry_type": {"type": "string", "enum": ["point", "line", "polygon", "raster", "table"]},
    "lat": {"type": ["number", "null"], "minimum": 17.7, "maximum": 18.6, "description": "WGS84 latitude when applicable."},
    "lon": {"type": ["number", "null"], "minimum": -67.4, "maximum": -65.1, "description": "WGS84 longitude when applicable."},
    "geometry": {"type": ["object", "null"], "description": "Full GeoJSON geometry when bound."},
    "source_ref": {"type": ["string", "null"], "description": "Evidence / source reference."},
    "evidence_tier": {"type": "string", "enum": ["T1", "T2", "T3", "T4"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "status": {"type": "string", "enum": ["active", "deprecated", "ghost", "planned", "review"]},
    "review_flag": {"type": "boolean"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
