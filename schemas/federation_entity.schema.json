{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "federation_entity",
  "title": "PRII Canonical Federation Entity",
  "description": "One entities[] record in the hub-facing canonical package written by scripts/federation_export.py. Record entities carry an optional Z2 location {lat, lon}. Consumed by thehub-pr.",
  "type": "object",
  "required": ["entity_id", "source_id", "name", "normalized_name", "entity_type", "jurisdiction", "confidence", "lineage", "synthetic", "created_at", "extracted_at"],
  "properties": {
    "entity_id": {"type": "string", "pattern": "^ent_[0-9a-f]{32}$"},
    "source_id": {"type": "string", "pattern": "^src_[0-9a-f]{32}$"},
    "name": {"type": ["string", "null"]},
    "normalized_name": {"type": "string"},
    "entity_type": {"type": "string", "enum": ["sensor_source", "airspace_event", "airspace_observation", "airspace_track", "aircraft"]},
    "jurisdiction": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "lineage": {"$ref": "#/definitions/lineage"},
    "synthetic": {"type": "boolean"},
    "created_at": {"type": "string", "minLength": 1},
    "extracted_at": {"type": "string", "minLength": 1},
    "location": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "lineage": {
      "type": "object",
      "required": ["producer_script", "producer_phase", "extraction_method"],
      "properties": {
        "producer_script": {"type": "string"},
        "producer_phase": {"type": "string"},
        "extraction_method": {"type": "string"},
        "source_inputs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
