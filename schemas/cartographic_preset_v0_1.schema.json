{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/spiderweb-pr/schemas/cartographic_preset_v0_1.schema.json",
  "title": "Spiderweb laboratory cartographic preset v0.1",
  "description": "Serialized display intent only. Layer keys must additionally resolve against the authorized GIS catalog. No source, geometry, access or analysis overrides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "layers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "layers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "visible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
