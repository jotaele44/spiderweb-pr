{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/spiderweb-pr/schemas/pr_grid_geographic_v2_manifest.schema.json",
  "title": "PR Grid Geographic V2 Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["Grid_ID", "Grid_Version", "CRS", "Origin_X", "Origin_Y", "Extent_XMin", "Extent_YMin", "Extent_XMax", "Extent_YMax", "Row_Direction", "Column_Direction", "Full_Cell_Policy", "Levels", "Cell_ID_Format", "Boundary_Semantics_Version", "Binding_Schema_Version", "Mask_Schema_Version", "Geometry_Generator_Version", "Release_State", "Source_Manifest_SHA256", "Cell_Schema_SHA256", "Binding_Schema_SHA256", "Mask_Schema_SHA256", "Grid_Manifest_SHA256"],
  "properties": {
    "Grid_ID": {"const": "PR_GRID_GEOGRAPHIC_V2"},
    "Grid_Version": {"const": "2.0.0-rc1"},
    "CRS": {"const": "EPSG:6566"},
    "Origin_X": {"const": 12000},
    "Origin_Y": {"const": 180000},
    "Extent_XMin": {"const": 12000},
    "Extent_YMin": {"const": 180000},
    "Extent_XMax": {"const": 354000},
    "Extent_YMax": {"const": 314000},
    "Row_Direction": {"const": "SOUTH_TO_NORTH"},
    "Column_Direction": {"const": "WEST_TO_EAST"},
    "Full_Cell_Policy": {"const": "FULL_SQUARE"},
    "Levels": {"type": "object"},
    "Cell_ID_Format": {"const": "PRG2:<LEVEL>:R<row:03d>:C<column:04d>"},
    "Boundary_Semantics_Version": {"const": "pr-grid-v2-boundary/1.0"},
    "Binding_Schema_Version": {"const": "pr-grid-v2-binding/1.0"},
    "Mask_Schema_Version": {"const": "pr-grid-v2-mask/1.0"},
    "Geometry_Generator_Version": {"const": "pr-grid-geographic-v2/rc1"},
    "Release_State": {"enum": ["RC1_CANDIDATE", "CERTIFIED"]},
    "Source_Manifest_SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Cell_Schema_SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Binding_Schema_SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Mask_Schema_SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Grid_Manifest_SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
