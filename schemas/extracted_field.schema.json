{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "extracted_field",
  "type": "object",
  "required": ["image_filename", "field_name", "ocr_confidence"],
  "properties": {
    "image_filename":     {"type": "string", "minLength": 1},
    "field_name":         {"type": "string", "minLength": 1},
    "value":              {"type": ["string", "number", "null"]},
    "ocr_confidence":     {"type": "number", "minimum": 0, "maximum": 1},
    "validation_score":   {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "consistency_score":  {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "combined_confidence":{"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "extraction_method":  {"type": ["string", "null"], "enum": ["tesseract", "ensemble", "manual", null]},
    "source_frame":       {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
