{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/spiderweb-pr/schemas/dem_platform_catalog.schema.json",
  "title": "Spiderweb DEM platform catalog",
  "description": "One entry per distinct elevation or bathymetry product, grouped by acquisition platform, with every registry registration attached as an alias or classified as a non-product. Read by source_adapters/dem_platform/catalog.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "active_vector",
    "checked",
    "vocabulary",
    "products",
    "non_product_registrations",
    "registry_conflicts"
  ],
  "properties": {
    "catalog_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "active_vector": {
      "type": "string",
      "minLength": 1
    },
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "vocabulary": {
      "type": "object"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "non_product_registrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_product"
      }
    },
    "registry_conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "id",
        "authority"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "boolean"
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "kind"
      ],
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "measurement",
            "fill",
            "control",
            "geolocation"
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "platform_class",
        "platforms",
        "instruments",
        "sensor_type",
        "surface_model",
        "acquisition_window",
        "vertical_datum",
        "vertical_datum_as_stated",
        "horizontal_datum",
        "native_resolution",
        "distribution_hosts",
        "acquisition_roots",
        "aliases",
        "consumed_by",
        "platform_basis",
        "platform_status",
        "notes"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "platform_class": {
          "enum": [
            "spaceborne",
            "airborne",
            "shipborne",
            "compiled"
          ]
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "short_name"
            ],
            "properties": {
              "short_name": {
                "type": "string",
                "minLength": 1
              },
              "long_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gcmd_type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "instruments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "short_name",
              "technique"
            ],
            "properties": {
              "short_name": {
                "type": "string",
                "minLength": 1
              },
              "technique": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sensor_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface_model": {
          "enum": [
            "radar_scattering_surface",
            "first_surface",
            "bare_earth",
            "point_cloud",
            "bathymetric",
            "topobathymetric",
            "mixed"
          ]
        },
        "acquisition_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ]
            },
            "end": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "vertical_datum": {
          "enum": [
            "EGM96",
            "EGM2008",
            "PRVD02",
            "NAVD88",
            "MHW",
            "MLLW",
            "MSL (assumed)",
            "undeclared"
          ]
        },
        "vertical_datum_as_stated": {
          "type": "string",
          "minLength": 1
        },
        "geoid_model": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^GEOID[0-9]{2}[A-Z]?$",
          "description": "The hybrid geoid model through which a survey reached a leveled vertical datum such as PRVD02 (for example GEOID12B, GEOID18). Null or absent where the datum is itself a geoid (EGM96, EGM2008) or the model is not stated."
        },
        "horizontal_datum": {
          "type": "string",
          "minLength": 1
        },
        "native_resolution": {
          "type": "string",
          "minLength": 1
        },
        "distribution_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acquisition_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/root"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "registration_status": {
          "enum": [
            "catalog_only"
          ]
        },
        "consumed_by": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider_ref",
              "products",
              "dependency_kind",
              "evidence"
            ],
            "properties": {
              "provider_ref": {
                "type": "string",
                "minLength": 1
              },
              "products": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependency_kind": {
                "enum": [
                  "geolocation",
                  "measurement"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "platform_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_tier",
            "source",
            "checked"
          ],
          "properties": {
            "evidence_tier": {
              "enum": [
                "T1",
                "T2",
                "T3",
                "T4"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "checked": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "platform_status": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "notes": {
          "type": "string"
        },
        "vertical_datum_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_tier",
            "sources",
            "checked"
          ],
          "properties": {
            "evidence_tier": {
              "enum": [
                "T1",
                "T2",
                "T3",
                "T4"
              ]
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "statement"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "not_retrieved": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "receipt": {
              "type": "string"
            },
            "checked": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      },
      "if": {
        "properties": {
          "aliases": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "required": [
          "registration_status"
        ]
      }
    },
    "non_product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "id",
        "classification",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "planned_not_acquired",
            "access_service",
            "provider_capability",
            "inventory_service",
            "survey_registry",
            "display_only"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "status",
        "description",
        "observations"
      ],
      "properties": {
        "conflict_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "id",
              "field",
              "value",
              "check"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "value": {},
              "check": {
                "enum": [
                  "equals",
                  "present",
                  "absent",
                  "abs_at_most"
                ]
              }
            }
          }
        }
      }
    }
  }
}
