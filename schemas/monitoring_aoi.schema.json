{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "monitoring_aoi",
  "title": "Remote Monitoring AOI",
  "description": "A versioned, explicit area of interest for remote-sensing monitoring — not an informal map bookmark. Each AOI is a polygon plus its monitoring objective, allowed detectors, and baseline/monitoring windows.",
  "type": "object",
  "required": ["aoi_uid", "name", "geometry", "aoi_class", "monitoring_objective"],
  "properties": {
    "aoi_uid":              {"type": "string", "minLength": 1},
    "name":                 {"type": "string", "minLength": 1},
    "aoi_class":            {"type": "string", "minLength": 1},
    "municipio":            {"type": ["string", "null"]},
    "monitoring_objective": {"type": "string", "minLength": 1},
    "allowed_detectors":    {"type": "array", "items": {"type": "string"}},
    "baseline_start":       {"type": ["string", "null"]},
    "monitoring_start":     {"type": ["string", "null"]},
    "priority":             {"type": "integer", "minimum": 1, "maximum": 5},
    "active":               {"type": "boolean"},
    "source_ref":           {"type": ["string", "null"]},
    "created_at":           {"type": ["string", "null"]},
    "retired_at":           {"type": ["string", "null"]},
    "review_status":        {"type": "string", "enum": ["seed", "reviewed", "retired"]},
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"type": "string", "enum": ["Polygon"]},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {"$ref": "#/definitions/prCoordinate"}
          }
        }
      }
    }
  },
  "definitions": {
    "longitude": {"type": "number", "minimum": -68.2, "maximum": -65.1},
    "latitude":  {"type": "number", "minimum": 17.8,  "maximum": 18.7},
    "prCoordinate": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {"$ref": "#/definitions/longitude"},
        {"$ref": "#/definitions/latitude"}
      ]
    }
  },
  "additionalProperties": true
}
