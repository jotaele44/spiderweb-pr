{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/spiderweb-pr/schemas/pr_grid_geographic_v2_cell.schema.json",
  "title": "PR Grid Geographic V2 Cell",
  "type": "object",
  "additionalProperties": false,
  "required": ["Grid_ID", "Grid_Version", "Grid_Level", "Cell_ID", "Row_Index", "Column_Index", "X_Min", "Y_Min", "X_Max", "Y_Max", "Area_m2", "CRS"],
  "properties": {
    "Grid_ID": {"const": "PR_GRID_GEOGRAPHIC_V2"},
    "Grid_Version": {"const": "2.0.0-rc1"},
    "Grid_Level": {"enum": ["L0", "L1", "L2", "L3"]},
    "Cell_ID": {"type": "string", "pattern": "^PRG2:L[0-3]:R[0-9]{3}:C[0-9]{4}$"},
    "Row_Index": {"type": "integer", "minimum": 0, "maximum": 535},
    "Column_Index": {"type": "integer", "minimum": 0, "maximum": 1367},
    "X_Min": {"type": "integer"},
    "Y_Min": {"type": "integer"},
    "X_Max": {"type": "integer"},
    "Y_Max": {"type": "integer"},
    "Area_m2": {"type": "integer", "minimum": 62500, "maximum": 4000000},
    "CRS": {"const": "EPSG:6566"}
  }
}
