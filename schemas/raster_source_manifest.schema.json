{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/spiderweb-pr/schemas/raster_source_manifest.schema.json",
  "title": "Spiderweb raster source manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "source_family",
    "evidence_tier",
    "repo_policy",
    "datasets"
  ],
  "additionalProperties": true,
  "properties": {
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "source_family": {
      "type": "string",
      "minLength": 1
    },
    "active_vector": {
      "type": "string"
    },
    "evidence_tier": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "repo_policy": {
      "type": "object",
      "required": [
        "commit_policy",
        "do_not_commit"
      ],
      "properties": {
        "commit_policy": {
          "type": "string"
        },
        "do_not_commit": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "allowed_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "catalog_coverage": {
      "type": "object",
      "properties": {
        "expected_universe_definition": {
          "type": "string"
        },
        "snapshot_rows_reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "pr_relevant_rows_located": {
          "type": "integer",
          "minimum": 0
        },
        "located_dataset_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage_status": {
          "type": "string"
        },
        "coverage_percent_against_uploaded_snapshot": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage_percent_against_live_ncei_catalog": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dataset_key",
          "name",
          "year",
          "status_in_snapshot",
          "vertical_datum",
          "horizontal_datum",
          "spatial_resolution",
          "validation"
        ],
        "properties": {
          "dataset_key": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$"
          },
          "name": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2200
          },
          "status_in_snapshot": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          },
          "vertical_datum": {
            "type": "string"
          },
          "horizontal_datum": {
            "type": "string"
          },
          "spatial_resolution": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "access_method": {
            "type": "string"
          },
          "opendap_url": {
            "type": "string",
            "pattern": "^https://.+\\.nc$"
          },
          "bounds_wgs84": {
            "type": "object",
            "required": [
              "min_lat",
              "max_lat",
              "min_lon",
              "max_lon"
            ],
            "properties": {
              "min_lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "max_lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "min_lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "max_lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "grid_shape": {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "integer",
                "minimum": 1
              },
              "lon": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "validation": {
            "type": "object",
            "required": [
              "promotion_status"
            ],
            "properties": {
              "promotion_status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "description",
          "closure_action"
        ],
        "properties": {
          "gap_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "closure_action": {
            "type": "string"
          }
        }
      }
    }
  }
}
