{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "physical_contract_crosswalk",
  "title": "Physical Contract Crosswalk",
  "description": "Connects a physical remote observation to a MoneySweep contract node WITHOUT asserting causation. reconciliation_status uses temporal-overlap and observability classes only. NO_SIGNAL_DETECTED means observability was adequate but nothing was seen — it must never be read as evidence that contracted work did not occur.",
  "type": "object",
  "required": [
    "crosswalk_uid",
    "contract_node_uid",
    "observation_uid",
    "reconciliation_status"
  ],
  "properties": {
    "crosswalk_uid":        {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "asset_uid":            {"type": ["string", "null"]},
    "contract_node_uid":    {"type": "string", "minLength": 1},
    "observation_uid":      {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "activity_period_start":{"type": ["string", "null"]},
    "activity_period_end":  {"type": ["string", "null"]},
    "contract_period_start":{"type": ["string", "null"]},
    "contract_period_end":  {"type": ["string", "null"]},
    "temporal_overlap_days":{"type": ["number", "null"]},
    "spatial_relationship": {"type": "string", "enum": ["within", "intersects", "adjacent", "contains", "disjoint"]},
    "expected_physical_signal": {"type": ["string", "null"]},
    "observed_signal":      {"type": ["string", "null"]},
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "CONSISTENT",
        "PARTIALLY_CONSISTENT",
        "NO_SIGNAL_DETECTED",
        "SIGNAL_OUTSIDE_CONTRACT_PERIOD",
        "INSUFFICIENT_OBSERVABILITY",
        "CONTRADICTORY_RECORDS",
        "NOT_ASSESSABLE"
      ]
    },
    "confidence":           {"type": "number", "minimum": 0, "maximum": 100},
    "notes":                {"type": "string"}
  },
  "additionalProperties": true
}
