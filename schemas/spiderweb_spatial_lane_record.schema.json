{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spiderweb_spatial_lane_record",
  "title": "Spiderweb-PR Spatial/Operational Lane Record",
  "description": "One normalized row written to data/normalized/*.csv by readiness/spiderweb_spatial_lane.py. Validates the 34 required fields from docs/pr_intake_router_spiderweb_lane.md. Values are CSV strings; producer-dependent fields (geometry/location/asset/agency) may be empty until the moneysweep-pr router derivative is enriched. additionalProperties allows the documented extension fields (final_status, title, summary_own_words, all_domains).",
  "type": "object",
  "required": [
    "record_id", "source_item_id", "canonical_repo", "related_moneysweep_record_id",
    "source_name", "source_url", "published_at", "discovered_at",
    "topic_domain", "spiderweb_layer_class",
    "municipality_name", "municipality_geoid", "location_text",
    "latitude", "longitude", "geometry_type", "geometry_confidence", "manual_geocode_required",
    "asset_or_feature_name", "asset_type", "dataset_type", "file_format", "crs", "temporal_coverage",
    "agency_entity", "federal_entity", "operational_entity", "activity_type",
    "evidence_tier", "confidence_level", "source_hash", "content_hash", "dedupe_group_id",
    "review_reason"
  ],
  "properties": {
    "record_id":                          {"type": "string", "minLength": 1},
    "source_item_id":                     {"type": "string", "minLength": 1},
    "canonical_repo":                     {"type": "string", "minLength": 1},
    "related_moneysweep_record_id": {"type": "string"},
    "source_name":                        {"type": "string"},
    "source_url":                         {"type": "string"},
    "published_at":                       {"type": "string"},
    "discovered_at":                      {"type": "string"},
    "topic_domain":                       {"type": "string", "minLength": 1},
    "spiderweb_layer_class":              {"type": "string", "minLength": 1},
    "municipality_name":                  {"type": "string"},
    "municipality_geoid":                 {"type": "string"},
    "location_text":                      {"type": "string"},
    "latitude":                           {"type": "string"},
    "longitude":                          {"type": "string"},
    "geometry_type":                      {"type": "string"},
    "geometry_confidence":                {"type": "string"},
    "manual_geocode_required":            {"type": "string", "enum": ["true", "false"]},
    "asset_or_feature_name":              {"type": "string"},
    "asset_type":                         {"type": "string"},
    "dataset_type":                       {"type": "string"},
    "file_format":                        {"type": "string"},
    "crs":                                {"type": "string"},
    "temporal_coverage":                  {"type": "string"},
    "agency_entity":                      {"type": "string"},
    "federal_entity":                     {"type": "string"},
    "operational_entity":                 {"type": "string"},
    "activity_type":                      {"type": "string"},
    "evidence_tier":                      {"type": "string"},
    "confidence_level":                   {"type": "string"},
    "source_hash":                        {"type": "string"},
    "content_hash":                       {"type": "string"},
    "dedupe_group_id":                    {"type": "string"},
    "review_reason":                      {"type": "string"}
  },
  "additionalProperties": true
}
