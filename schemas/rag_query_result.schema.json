{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rag_query_result",
  "type": "object",
  "required": ["answer", "query"],
  "properties": {
    "query":   {"type": "string"},
    "answer":  {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id":        {"type": "string"},
          "subreddit": {"type": ["string", "null"]},
          "excerpt":   {"type": ["string", "null"]}
        }
      }
    }
  },
  "additionalProperties": true
}
