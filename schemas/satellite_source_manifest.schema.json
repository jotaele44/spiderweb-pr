{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "satellite_source_manifest",
  "title": "Satellite Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "schema_version",
    "producer",
    "created_at",
    "synthetic",
    "source",
    "acquisition",
    "asset",
    "geometry",
    "puerto_rico",
    "quality",
    "lineage"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "collection", "platform", "instrument"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquired_at", "processed_at", "license"],
      "properties": {
        "acquired_at": {
          "type": "string",
          "minLength": 1
        },
        "processed_at": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checksum_sha256", "media_type"],
      "anyOf": [
        {"required": ["source_uri"]},
        {"required": ["local_path"]}
      ],
      "properties": {
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "type": "string",
          "minLength": 1
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image/tiff",
            "image/geotiff",
            "application/geo+json",
            "application/json"
          ]
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crs", "footprint", "bbox"],
      "properties": {
        "crs": {
          "type": "string",
          "enum": ["EPSG:4326"]
        },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["Polygon"]
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "$ref": "#/definitions/prCoordinate"
                }
              }
            }
          }
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"type": "number", "minimum": -68.2, "maximum": -65.1},
            {"type": "number", "minimum": 17.8, "maximum": 18.7},
            {"type": "number", "minimum": -68.2, "maximum": -65.1},
            {"type": "number", "minimum": 17.8, "maximum": 18.7}
          ],
          "items": false
        }
      }
    },
    "puerto_rico": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "pr_bbox_intersection"],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        },
        "municipality": {
          "type": ["string", "null"]
        },
        "pr_bbox_intersection": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloud_cover_pct", "geometric_confidence", "source_reliability"],
      "properties": {
        "cloud_cover_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "geometric_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "processing_level"],
      "properties": {
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "processing_level": {
          "type": "string",
          "minLength": 1
        },
        "parent_manifest_id": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {"const": false}
        },
        "required": ["synthetic"]
      },
      "then": {
        "properties": {
          "asset": {
            "properties": {
              "source_uri": {
                "not": {
                  "pattern": "(?i)(fixture|mock|test)"
                }
              },
              "local_path": {
                "not": {
                  "pattern": "(?i)(fixture|mock|test)"
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "prCoordinate": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "number", "minimum": -68.2, "maximum": -65.1},
        {"type": "number", "minimum": 17.8, "maximum": 18.7}
      ],
      "items": false
    }
  }
}
