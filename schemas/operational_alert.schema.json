{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "operational_alert",
  "type": "object",
  "required": ["alert_id", "callsign", "severity"],
  "properties": {
    "alert_id":             {"type": "string", "minLength": 1},
    "flight_id":            {"type": ["string", "null"]},
    "callsign":             {"type": "string", "minLength": 1},
    "category": {
      "type": ["string", "null"],
      "enum": [
        "Restricted Airspace Entry",
        "Unusual Flight Behavior",
        "Critical Infrastructure Proximity",
        "Unknown/Unidentified Aircraft",
        "Temporal Anomaly (Physics Violation)",
        "Pattern Deviation from Historical Norm",
        "Extended Operation (Possible Emergency)",
        "Previously Unseen Aircraft",
        "Night Operation (Non-Emergency Operator)",
        "Behavioral Cluster Deviation",
        null
      ]
    },
    "severity":             {"type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "title":                {"type": ["string", "null"]},
    "description":          {"type": ["string", "null"]},
    "evidence":             {"type": ["array", "null"], "items": {"type": "string"}},
    "timestamp":            {"type": ["string", "null"]},
    "recommended_action":   {"type": ["string", "null"]},
    "auto_resolved":        {"type": ["integer", "boolean", "null"]},
    "auto_resolved_reason": {"type": ["string", "null"]},
    "acknowledged":         {"type": ["integer", "boolean", "null"]},
    "acknowledged_at":      {"type": ["string", "null"]},
    "created_at":           {"type": ["string", "null"]},
    "suppressed_until":     {"type": ["string", "null"]},
    "suppression_reason":   {"type": ["string", "null"]},
    "escalation_count":     {"type": ["integer", "null"], "minimum": 0}
  },
  "additionalProperties": true
}
