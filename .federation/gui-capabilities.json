{
  "schema_version": "prii.gui-capability/v1",
  "repository": "jotaele44/spiderweb-pr",
  "policy": {
    "mode": "ratchet",
    "baseline": ".federation/gui-parity-baseline.json",
    "require_discoverable_gui": true,
    "require_e2e": true,
    "terminal_free_user_path": true
  },
  "discovery": {
    "backend_roots": [
      "server/backend",
      "desktop"
    ],
    "production_roots": [
      "spiderweb",
      "fr24",
      "integration",
      "federation",
      "readiness",
      "server/ingestion",
      "desktop"
    ],
    "analysis_roots": [
      "pipeline",
      "earthgpt",
      "imagery",
      "gebco",
      "scripts",
      "tools"
    ],
    "frontend_roots": [
      "server/frontend/src"
    ],
    "frontend_capability_roots": [
      "server/frontend/src/components",
      "server/frontend/src/modules"
    ],
    "frontend_api_roots": [
      "server/frontend/src/api/client.ts"
    ],
    "route_files": [],
    "navigation_files": [
      "server/frontend/src/App.tsx"
    ],
    "implicit_routes": [
      {
        "path": "/",
        "file": "server/frontend/src/App.tsx"
      }
    ],
    "exclude": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "scripts/check_gui_parity.py",
      "tools/site_confidence/vendor/**"
    ]
  },
  "capabilities": [
    {
      "id": "spatial-financial-workbench",
      "classification": "analysis",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /agencies",
          "GET /vendors",
          "GET /sites",
          "GET /contracts",
          "GET /events",
          "GET /anomalies",
          "GET /sources",
          "GET /investigations",
          "GET /alerts",
          "GET /geo/{layer}.geojson",
          "GET /catalog",
          "POST /pipeline/run",
          "GET /pipeline/status/{job_id}",
          "GET /pipeline/events/{job_id}",
          "DELETE /pipeline/{job_id}",
          "POST /rag/query",
          "POST /rag/index"
        ]
      },
      "frontend": {
        "routes": [
          "/"
        ],
        "e2e_routes": [
          "/"
        ],
        "components": [
          "server/frontend/src/App.tsx",
          "server/frontend/src/api/client.ts",
          "server/frontend/src/modules/CommandCenter.tsx",
          "server/frontend/src/modules/FinanceIntelligence.tsx",
          "server/frontend/src/modules/SpatialIntelligence.tsx",
          "server/frontend/src/modules/AnomalyWorkbench.tsx",
          "server/frontend/src/modules/InvestigationGraph.tsx",
          "server/frontend/src/modules/QueryLayer.tsx"
        ],
        "discoverability": [
          "server/frontend/src/App.tsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_priis_api.py",
          "tests/test_geo_routes.py",
          "tests/test_layer_catalog.py"
        ],
        "contract": [
          "tests/test_gui_parity.py",
          "server/frontend/src/api/client.test.ts",
          "server/frontend/src/modules/FinanceIntelligence.test.tsx",
          "server/frontend/src/modules/SpatialIntelligence.test.ts"
        ],
        "e2e": [
          "server/frontend/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "dashboard-host-health",
      "classification": "internal",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Health and shell-serving endpoints support launch and readiness; they do not represent a separate user workflow.",
      "backend": {
        "files": [
          "server/backend/main.py",
          "desktop/app_server.py"
        ],
        "endpoints": [
          "GET /health"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_server_smoke.py",
          "tests/test_desktop_app_server.py"
        ]
      }
    }
  ],
  "exceptions": []
}
